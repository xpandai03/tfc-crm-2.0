# ============================================================================
# TFC CRM — Staging Environment Variables
# ============================================================================
# Copy this file to .env for local staging, or set these as Fly secrets:
#   fly secrets set KEY=VALUE --app tfc-crm-2-staging
# ============================================================================

# ---------- App Identity ----------
NODE_ENV=production
PORT=3000
APP_URL=https://tfc-crm-2-0.fly.dev

# ---------- Auth (set to "disabled" to bypass Azure AD entirely) ----------
AZURE_AD_CLIENT_ID=disabled
AZURE_AD_CLIENT_SECRET=disabled
AZURE_AD_TENANT_ID=disabled
SESSION_SECRET=staging-session-secret-change-me

# ---------- n8n Webhooks (set to "disabled" to skip all n8n calls) ----------
N8N_GET_WAITLIST_BOARD_URL=disabled
N8N_GET_WAITLIST_SUMMARY_URL=disabled
N8N_GET_CONTACT_SNAPSHOT_URL=disabled
N8N_UPDATE_CONTACT_STATUS_URL=disabled
N8N_ADD_CONTACT_NOTE_URL=disabled
N8N_ASSIGN_CONTACT_URL=disabled
N8N_UNASSIGN_CONTACT_URL=disabled

# ---------- Data Mode ----------
# "auto" uses sync cache if available, falls back to n8n
# "sync" always reads from SQLite (requires sync job)
# "n8n" always calls n8n (legacy)
READ_SOURCE=sync

# ---------- Sync API ----------
# MUST be different from production. Leave empty to disable inbound sync entirely.
SYNC_API_KEY=

# ---------- Provider Availability Form ----------
# Shared secret used by the standalone Fly.io provider availability form to
# authenticate POSTs to /api/provider-availability via the X-Provider-Form-Key
# header. MUST match the value set in the form app's environment. Leave empty
# to disable the endpoint entirely (returns 503).
PROVIDER_FORM_API_KEY=

# ---------- TherapyNotes ----------
TN_AGENT_URL=disabled
TN_API_KEY=

# ---------- Email (Resend) ----------
# Leave blank to disable outbound email entirely.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
RESEND_FROM_EMAIL=

# ---------- Survey ----------
SURVEY_URL=https://customer-feedback-tfc.replit.app

# ---------- Provider Spreadsheet ----------
PROVIDER_SPREADSHEET_PATH=data/Provider Skills Spreadsheet.xlsx
